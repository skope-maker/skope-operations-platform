# Backend origin the frontend calls (without the /api suffix).
# Leave empty to call same-origin /api (dev server and `vite preview` proxy it to the backend).
VITE_BACKEND_URL=

# Legacy name, still honoured if VITE_BACKEND_URL is not defined.
# REACT_APP_BACKEND_URL=https://your-backend.example.com

# Optional: where `vite dev` / `vite preview` proxy /api (default http://localhost:8001).
# VITE_DEV_PROXY_TARGET=http://localhost:8001
