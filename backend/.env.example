# Settings for the backend. Copy to ".env" next to this file and fill in your own values.
# Never commit the real .env file: it holds secrets.

# --- required ---
MONGO_URL=mongodb://localhost:27017      # or your MongoDB Atlas connection string
DB_NAME=skope_operations
JWT_SECRET=                              # a long random string; signs login tokens

# --- administrator account (created on first start; the password is re-applied at every start) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=                          # choose a strong password

# --- optional: five role accounts for team testing ---
SEED_DEMO_USERS=false                    # true = create procurement, keeper, manager, chef, management accounts
DEMO_PASSWORD=                           # their shared password (6+ characters); required when SEED_DEMO_USERS=true

# --- optional ---
STORAGE_BACKEND=local                    # local = uploads saved on disk; remote = the old hosted store
UPLOAD_DIR=                              # where local uploads go (default: backend/uploads; keep the path short on Windows)
CORS_ORIGINS=*                           # website addresses allowed to call the API, comma separated; use your own address when public
FRONTEND_DIST=                           # folder of the built frontend to serve (default: ../frontend/build when it exists)
